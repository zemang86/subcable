# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# electron-builder output
/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# large source textures
*.tif

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# import script cache (raw upstream GeoJSON, regenerated on demand)
/scripts/.cache/

# landing-point photo drop zone — full-res sources only (~100MB of 2000px
# screenshots). The committed artefact is the WebP under public/images/,
# generated by scripts/import-landing-images.mjs. See the README there.
/assets/landing-points/*/*
!/assets/landing-points/*/.gitkeep

# scratch / shared-UI snippets (CSS handoff drops)
/temp/

# per-developer working scratchpad (tasks/lessons.md stays tracked)
/tasks/todo.md
docs/temp-video/
